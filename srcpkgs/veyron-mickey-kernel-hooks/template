# Template file for 'veyron-mickey-kernel-hooks'
pkgname=veyron-mickey-kernel-hooks
version=1.0
revision=1
archs="armv7l*"
depends="linux u-boot-tools vboot-utils dtc lz4"
short_desc="Automated vboot FIT image bundle generator for ASUS Chromebit"
maintainer="maldridge <maldridge@voidlinux.org>"
license="BSD-2-Clause"
homepage="https://voidlinux.org"

do_install() {
	# Install the kernel hooks into Void's standard kernel execution tree
	vinstall ${FILESDIR}/50-chromebit-vboot.post-install 755 etc/kernel.d/post-install 50-chromebit-vboot
	vinstall ${FILESDIR}/50-chromebit-vboot.post-remove 755 etc/kernel.d/post-remove 50-chromebit-vboot

	# Install the static FIT image profile template
	vinstall ${FILESDIR}/veyron-fit.its 644 etc/kernel.d veyron-fit.its
}
