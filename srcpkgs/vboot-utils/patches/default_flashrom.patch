Google's own flashrom has a bunch of quirk handling baked in which
does not exist in upstream flashrom.  Upstream flashrom handles
these quirks using its own chip database, so this is reasonably
safe.

--- a/host/lib/flashrom_drv.c
+++ b/host/lib/flashrom_drv.c
@@ -434,14 +434,11 @@
 	if (flashrom_setup(&flashctx, &prog, NULL, prog_with_params) != VB2_SUCCESS)
 		return VB2_ERROR_FLASHROM;
 
-	struct flashrom_flashchip_info info;
-	flashrom_flash_getinfo(flashctx, &info);
-
-	*vendor = strdup(info.vendor);
-	*name = strdup(info.name);
-	*vid = info.manufacture_id;
-	*pid = info.model_id;
-	*flash_len = info.total_size * 1024;
+	*vendor = strdup("");
+	*name = strdup("");
+	*vid = 0;
+	*pid = 0;
+	*flash_len = flashrom_flash_getsize(flashctx);
 
 	flashrom_flash_release(flashctx);
 	if (flashrom_programmer_shutdown(prog))
