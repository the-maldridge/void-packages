do_install() {
	vmkdir usr/share/icons/cosmic
	cd freedesktop
	find ./scalable -type f -exec install -Dm0644 {} $DESTDIR/usr/share/icons/cosmic/{} \;
	cd ../extra
	find ./scalable -type f -exec install -Dm0644 {} $DESTDIR/usr/share/icons/cosmic/{} \;
}
