post_install() {
	vbin data/start-cosmic
	vmkdir usr/share/wayland-sessions
	vinstall data/cosmic.desktop 0644 usr/share/wayland-sessions/
	vmkdir usr/share/dconf/profile
	vinstall data/dconf/profile/cosmic 0644 usr/share/dconf/profile/cosmic
}
